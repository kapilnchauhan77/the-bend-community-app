# ─────────────────────────────────────────────────────────────
# The Bend Community — Production VM Deployment
# Copy this to .env and fill in real values before running deploy.sh
# ─────────────────────────────────────────────────────────────

# === Domain ===
BASE_DOMAIN=bend.community
ACME_EMAIL=admin@bend.community
# Cloudflare API token scoped to: Zone:Zone:Read + Zone:DNS:Edit on bend.community
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# === Frontend build args (baked into the Vite build) ===
VITE_API_URL=https://api.bend.community/api/v1
VITE_BASE_DOMAIN=bend.community
# Cloudflare Web Analytics — privacy-friendly traffic stats. Get the token
# from Cloudflare dashboard → Analytics → Web Analytics → Add a site.
# Leave empty to skip the analytics script entirely.
VITE_CF_ANALYTICS_TOKEN=

# === Backend ===
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_CHAR_STRING
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_CHAR_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — wildcard subdomains handled by allow_origin_regex in main.py
CORS_ORIGINS=["https://bend.community"]

# Frontend URL used for Stripe redirects and email links (default tenant)
FRONTEND_URL=https://westmoreland.bend.community

# === Postgres ===
POSTGRES_DB=thebend
POSTGRES_USER=thebend
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# === Super Admin (created by seed on first boot) ===
SUPER_ADMIN_EMAIL=super@bend.community
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_8

# === Stripe ===
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# === Email ===
# Resend (preferred). Create an API key at https://resend.com/api-keys and
# verify the sending domain (bend.community) at https://resend.com/domains
# by adding the DNS records it shows to Cloudflare.
RESEND_API_KEY=
# SendGrid (legacy fallback — only used if RESEND_API_KEY is empty)
SENDGRID_API_KEY=
EMAIL_FROM=support@bend.community
EMAIL_FROM_NAME=The Bend Community

# === AWS S3 (optional — for upload storage) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# === Web Push (VAPID) — optional ===
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=admin@bend.community

# Native push (optional; provider credentials come from secret storage)
FIREBASE_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=community.bend.westmoreland
APNS_USE_SANDBOX=false
PUBLIC_CONTENT_PROHIBITED_TERMS=[]
