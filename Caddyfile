{
	email {$ACME_EMAIL}
}

# Redirect www.<apex> → <apex> (covered by the *.bend.community wildcard cert)
www.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		key_type rsa2048
		# Accept legacy TLS for old Windows/IE clients (weakens security for all
		# visitors — deliberate tradeoff). Modern AEAD suites are listed first so
		# up-to-date clients still get forward-secret GCM/ChaCha; the CBC/3DES
		# suites exist only so TLS 1.0/1.1 clients can complete a handshake.
		protocols tls1.0 tls1.3
		ciphers TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA
	}
	redir https://{$BASE_DOMAIN}{uri} permanent
}

# API on api.bend.community → backend
api.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		key_type rsa2048
		# Accept legacy TLS for old Windows/IE clients (weakens security for all
		# visitors — deliberate tradeoff). Modern AEAD suites are listed first so
		# up-to-date clients still get forward-secret GCM/ChaCha; the CBC/3DES
		# suites exist only so TLS 1.0/1.1 clients can complete a handshake.
		protocols tls1.0 tls1.3
		ciphers TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA
	}
	reverse_proxy backend:8000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
	encode gzip zstd
}

# Root + all tenant subdomains → frontend (nginx serving Vite SPA),
# except social crawlers hitting /listing/{id} get a server-rendered OG
# preview page from the backend so shared links render as rich cards.
{$BASE_DOMAIN}, *.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		key_type rsa2048
		# Accept legacy TLS for old Windows/IE clients (weakens security for all
		# visitors — deliberate tradeoff). Modern AEAD suites are listed first so
		# up-to-date clients still get forward-secret GCM/ChaCha; the CBC/3DES
		# suites exist only so TLS 1.0/1.1 clients can complete a handshake.
		protocols tls1.0 tls1.3
		ciphers TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA
	}

	# Match well-known social-platform crawlers on listing URLs.
	@og_crawler {
		header_regexp User-Agent (?i)facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|telegrambot|whatsapp|discordbot|pinterest|redditbot|applebot|googlebot|bingbot|embedly|vkshare|w3c_validator|skype|ia_archiver|bitlybot
		path_regexp listing ^/listing/([^/]+)/?$
	}

	handle @og_crawler {
		rewrite * /share/listing/{re.listing.1}
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else (real users) → SPA, unchanged.
	handle {
		reverse_proxy frontend:80 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	encode gzip zstd
}
